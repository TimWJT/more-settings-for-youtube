{
  "manifest_version": 3,
  "name": "More Settings for YouTube",
  "version": "1.0.7",
  "description": "Copy YouTube transcripts in one click (button by Subscribe, Alt+Shift+T, popup), speed past 2x with Shift+. / Shift+,, block 0-9 seeking, Shift+/ fix, bigger theater mode and more.",
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "action": {
    "default_icon": "icon.svg",
    "default_popup": "popup.html",
    "default_title": "More Settings for YouTube"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "commands": {
    "copy-transcript": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "Copy the YouTube transcript"
    }
  },
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "*://www.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*"
      ],
      "js": [
        "settings.js",
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://www.youtube.com/*"
      ],
      "js": [
        "page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "more-settings-for-youtube@timwjt",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}